# Copiar a .env (nunca subir .env al repositorio).
RABBITMQ_URL=amqp://USUARIO:CLAVE@rabbit1:5672
DATABASE_URL=postgres://eventos_app:CLAVE_EVENTOS@postgres:5432/vidalstore
# Dominio con el que se arma el "para" de los avisos (el envío de correo es simulado).
AVISOS_DOMINIO=avisos.vidalstore.local
# Solo desarrollo: deja que TypeORM sincronice tablas. Ignorado si NODE_ENV=production.
DB_SYNCHRONIZE=false
PORT=3010
